        <mxCell id="legend" value="Solid bold arrows = message flow through the broker.&#10;Dashed arrows = store writes and the HTTP response path.&#10;x-death header on any DLQ message records both hops: expired (from task_queue.retry) and rejected (from task_queue)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
