          <mxGeometry x="540" y="250" width="540" height="470" as="geometry" />
        </mxCell>
        <mxCell id="taskq" value="task_queue   (durable=True)&#10;x-dead-letter-exchange = task_dlx&#10;x-dead-letter-routing-key = task_queue.dead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d9822b;fontSize=12;" vertex="1" parent="1">
