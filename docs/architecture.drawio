        <mxCell id="e9" value="9. GET /result/{id}   →  SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e8b57;dashed=1;fontSize=11;" edge="1" parent="1" source="api" target="db">
