        </mxCell>
        <mxCell id="retryq" value="task_queue.retry  (durable)&#10;per-message expiration = 2s / 4s / 8s&#10;x-dead-letter-exchange = ''  → task_queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d9822b;fontSize=12;" vertex="1" parent="1">
