        <mxCell id="e16" value="UPDATE status=error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7b3fa0;dashed=1;fontSize=11;" edge="1" parent="1" source="consumer" target="db">
