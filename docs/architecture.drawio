        <mxCell id="e11" value="11. transient, retries left&#10;publish x-retry+1, expiration=backoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d9822b;fontSize=11;" edge="1" parent="1" source="consumer" target="retryq">
