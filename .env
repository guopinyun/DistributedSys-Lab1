# Copy to .env and edit. Shell variables override anything set here.
# .env is gitignored, so machine-specific values stay local.

# --- broker (Step 1) ---------------------------------------------------------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Low values make a killed consumer vanish from the broker sooner. Ctrl-C does
# not need this; it only bounds the damage from a hard kill.
RABBITMQ_HEARTBEAT=30

# --- queue names -------------------------------------------------------------
QUEUE_NAME=task_queue

# --- exercise 1.3: acknowledgement, durability, crash ------------------------
# true  = broker forgets the message on delivery; a crash destroys it
# false = manual ack; the broker redelivers anything unacknowledged
AUTO_ACK=false
# Exercise 1.3's crash demo. CRASH_AFTER_N makes the consumer os._exit(1) after
# it has processed its Nth message but before acking it, so you can watch the
# message come back. Use this one: POST /process generates the message id, so it
# cannot be predicted in advance. 0 = never crash.
CRASH_AFTER_N=0
# Die on one specific id instead. Only useful if you already know the id.
CRASH_AT_MESSAGE=
CRASH_AFTER_S=2
# A queue's arguments are fixed at declaration. Flipping this after task_queue
# already exists gives 406 PRECONDITION_FAILED -- that is the lesson, not a bug.
# Reset with:  docker exec rabbitMQ rabbitmqctl delete_queue task_queue
QUEUE_DURABLE=true
# delivery_mode=2. Survives a broker restart, which requires both of these.
MESSAGE_PERSISTENT=true

# --- exercise 1.2 vs task A --------------------------------------------------
# log = exercise 1.2, fixed rate, no AI call (the only way to watch depth fall
#       at 1 msg/s, since a real llama3.2:1b call takes ~10s)
# ai  = task A, the assessed end-to-end path
CONSUMER_MODE=ai
# Messages per second in log mode. 0 = as fast as possible. In ai mode the model
# latency dominates (~0.1 msg/s measured).
CONSUMER_RATE=0.0
# Never let the broker push more than this many unacked messages at us, or
# pika buffers the queue client-side and the management UI under-reports.
PREFETCH_COUNT=1

# --- AI backend (Step 3, Option A: local Ollama) -----------------------------
# Task B's failure test: set this to http://127.0.0.1:9 (nothing listens there)
# and restart the consumer to get a real ConnectError.
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:1b
# 10s per call was measured for 30 tokens on this machine; 60s leaves headroom.
AI_TIMEOUT_S=60
# Lower this and the queue drains faster.
AI_MAX_TOKENS=64
# Artificial delay before the AI call. Only used to widen the window in which a
# demonstrator has to hit Ctrl-C for the harness's criterion 2. 0 = off.
AI_DELAY_S=0

# --- retry and dead-lettering (tasks A and B) --------------------------------
# Total attempts = MAX_RETRIES + 1, so 3 means try once, retry 3x, then DLQ.
MAX_RETRIES=3
# Exponential backoff per retry: 2s, 4s, 8s. The whole dead-letter path settles
# in ~14s, well inside the harness's 120s wait.
RETRY_BASE_MS=2000

# --- store and service -------------------------------------------------------
DB_PATH=lab.sqlite3
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8081
LOG_LEVEL=INFO
